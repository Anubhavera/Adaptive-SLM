**JavaScript for interaction:**

```javascript
// File: demo-frontend/app.js
const API_URL = 'http://localhost:5000';  // Change to production URL later

let currentProfile = 'intermediate';
let adaptiveMetrics = { speed: [], memory: [] };
let baselineMetrics = { speed: [], memory: [] };

// Profile selection
document.querySelectorAll('.profile-card').forEach(card => {
    card.addEventListener('click', () => {
        document.querySelectorAll('.profile-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        currentProfile = card.dataset.profile;
        console.log(`Profile switched to: ${currentProfile}`);
    });
});

// Sample prompts
document.querySelectorAll('.sample-prompt').forEach(btn => {
    btn.addEventListener('click', () => {
        document.getElementById('user-input').value = btn.textContent;
        sendMessage();
    });
});

// Send message
document.getElementById('send-btn').addEventListener('click', sendMessage);
document.getElementById('user-input').addEventListener('keypress', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
    }
});

async function sendMessage() {
    const input = document.getElementById('user-input');
    const prompt = input.value.trim();
    
    if (!prompt) return;
    
    // Clear input
    input.value = '';
    
    // Add user message to both columns
    addMessage('messages-adaptive', prompt, 'user');
    addMessage('messages-baseline', prompt, 'user');
    
    // Show loading
    const loadingAdaptive = addMessage('messages-adaptive', '...', 'assistant', true);
    const loadingBaseline = addMessage('messages-baseline', '...', 'assistant', true);
    
    try {
        // Call both models in parallel
        const [adaptiveResponse, baselineResponse] = await Promise.all([
            generateResponse(prompt, currentProfile, true),
            generateResponse(prompt, 'general', false)  // Baseline doesn't use profile
        ]);
        
        // Remove loading, add responses
        loadingAdaptive.remove();
        loadingBaseline.remove();
        
        addMessage('messages-adaptive', adaptiveResponse.response, 'assistant');
        addMessage('messages-baseline', baselineResponse.response, 'assistant');
        
        // Update metrics
        updateMetrics(adaptiveResponse, baselineResponse);
        
    } catch (error) {
        console.error('Error:', error);
        loadingAdaptive.textContent = 'Error generating response';
        loadingBaseline.textContent = 'Error generating response';
    }
}

async function generateResponse(prompt, profile, isAdaptive) {
    const startTime = Date.now();
    
    const response = await fetch(`${API_URL}/generate`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prompt, profile })
    });
    
    const data = await response.json();
    data.latency = Date.now() - startTime;
    
    return data;
}

function addMessage(containerId, text, role, isLoading = false) {
    const container = document.getElementById(containerId);
    const msg = document.createElement('div');
    msg.className = `message ${role} ${isLoading ? 'loading' : ''}`;
    msg.textContent = text;
    container.appendChild(msg);
    container.scrollTop = container.scrollHeight;
    return msg;
}

function updateMetrics(adaptiveData, baselineData) {
    // Update speed metrics
    document.getElementById('tokens-adaptive').textContent = `${adaptiveData.tokens_per_sec} tok/s`;
    document.getElementById('tokens-baseline').textContent = `${baselineData.tokens_per_sec} tok/s`;
    
    // Update memory metrics
    document.getElementById('memory-adaptive').textContent = `${adaptiveData.memory_mb} MB`;
    document.getElementById('memory-baseline').textContent = `${baselineData.memory_mb} MB`;
    
    // Update charts (Chart.js)
    adaptiveMetrics.speed.push(adaptiveData.tokens_per_sec);
    baselineMetrics.speed.push(baselineData.tokens_per_sec);
    
    updateCharts();
}

function updateCharts() {
    // Implementation using Chart.js
    // ... (add charts for speed/memory comparison)
}

// Initialize charts on page load
window.addEventListener('load', () => {
    console.log('AdaptiveSLM Demo loaded successfully');
});
```

