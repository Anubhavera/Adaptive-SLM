## Implementation Plan

### Phase 1: Backend API (Days 1-2)

**Create a simple Python Flask server** that wraps your C++ inference engine:

```python
# File: demo-server/app.py
from flask import Flask, request, jsonify
from flask_cors import CORS
import subprocess
import json

app = Flask(__name__)
CORS(app)  # Allow browser to call API

@app.route('/generate', methods=['POST'])
def generate():
    data = request.json
    prompt = data.get('prompt', '')
    profile = data.get('profile', 'general')
    
    # Call your C++ inference engine
    result = subprocess.run([
        '../core/build/adaptive_slm_cli',
        '--model', '../models/qwen2.5-0.5b-instruct-q4_k_m.gguf',
        '--prompt', prompt,
        '--profile', profile
    ], capture_output=True, text=True)
    
    return jsonify({
        'response': result.stdout,
        'profile': profile,
        'tokens_per_sec': 35,  # Parse from output
        'memory_mb': 412       # Parse from output
    })

@app.route('/health', methods=['GET'])
def health():
    return jsonify({'status': 'ok'})

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000)
```

**Alternative: Use your Rust wrapper directly**
```python
# If you want to use Rust instead:
from adaptive_slm_py import AdaptiveSLM  # Create Python bindings

slm = AdaptiveSLM("../models/qwen2.5-0.5b-instruct-q4_k_m.gguf")

@app.route('/generate', methods=['POST'])
def generate():
    data = request.json
    response = slm.generate(
        data['prompt'], 
        profile=data['profile']
    )
    return jsonify(response)
```

